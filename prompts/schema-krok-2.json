{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SideQuest, krok 2: odpowiedzi → Brief Inicjatywy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "unclear_topic",
    "follow_up",
    "brief"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "brief",
        "niezrozumiale",
        "pytanie_zwrotne"
      ],
      "description": "brief = gotowy Brief. niezrozumiale = jedna odpowiedź bez sensu, aplikacja pyta jeszcze raz. pytanie_zwrotne = szkodliwy pomysł, jedno pytanie przed Briefem."
    },
    "unclear_topic": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "dzialanie",
            "zasoby"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Tylko przy status = niezrozumiale."
    },
    "follow_up": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Tylko przy status = pytanie_zwrotne. Jedno łagodne pytanie o sąsiadów."
    },
    "brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/brief_inicjatywy"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "zrodlo": {
      "type": "string",
      "enum": [
        "gracz",
        "ai"
      ],
      "description": "ai = Gracz napisał „nie wiem”, a tekst zaproponowało AI. Aplikacja oznacza go ✨."
    },
    "brief_inicjatywy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "category",
        "problem",
        "proposed_action",
        "why_it_matters",
        "resources",
        "who_fixes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "inicjatywa"
        },
        "title": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "enum": [
            "zdrowie",
            "infrastruktura",
            "edukacja",
            "kultura",
            "bezpieczenstwo",
            "zielen",
            "sport",
            "rowery",
            "spoleczenstwo"
          ]
        },
        "problem": {
          "type": "string"
        },
        "proposed_action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/zrodlo"
            }
          }
        },
        "why_it_matters": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/zrodlo"
            }
          }
        },
        "who_fixes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "city_needed",
            "reason",
            "confidence"
          ],
          "description": "Kto naprawi = Miasto, gdy city_needed = true, inaczej Gracze. Liczy to serwer.",
          "properties": {
            "city_needed": {
              "type": "boolean",
              "description": "Czy to teren miasta albo potrzeba zgody lub pieniędzy miasta?"
            },
            "reason": {
              "type": "string"
            },
            "confidence": {
              "type": "string",
              "enum": [
                "niska",
                "srednia",
                "wysoka"
              ]
            }
          }
        }
      }
    }
  }
}
