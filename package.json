{
  "name": "sidequest-backend",
  "version": "0.1.0",
  "private": true,
  "description": "SideQuest backend API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:prod:docker": "npm run db:deploy && node dist/main",
    "test": "tsx --test src/**/*.spec.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push --skip-generate",
    "db:setup": "npm run prisma:generate && npm run db:push",
    "czat": "tsx scripts/czat.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "openai": "^7.27.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "@prisma/client": "^6.19.0",
    "prisma": "^6.19.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
