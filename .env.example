# Klucz API OpenAI. Nigdy nie wysyłaj prawdziwego klucza do gita.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=8000

# KCK / storage
KCK_TIMEOUT_MS=15000
SIDEQUEST_DATA_DIR=./data
# Punkty za skuteczne zgłoszenie KCK; serwer nalicza je dopiero po incidentId.
KCK_INCIDENT_POINTS=10
