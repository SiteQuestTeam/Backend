DATABASE_URL="file:./dev.db"
# ResourcePortal production value (set it as an environment variable, do not
# commit it to .env): DATABASE_URL="file:/app/data/dev.db"

# Klucz API OpenAI dla lokalnego uruchomienia. W Docker Swarm backend preferuje
# sekret zamontowany jako /run/secrets/OPENAI_API_KEY. Nigdy nie wysyłaj prawdziwego klucza do gita.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=8000
# Krok 2 (pisanie Briefu) trwa ok. 8 s, więc ma dłuższy limit.
OPENAI_TIMEOUT_KROK_2_MS=15000

# KCK: mock (domyślnie) nic nie wysyła do Miasta i zwraca numer MOCK-...
# live wysyła prawdziwe, anonimowe zgłoszenie do kontakt.krakow.pl.
KCK_MODE=mock
KCK_TIMEOUT_MS=15000
MSIP_TIMEOUT_MS=5000

# Local photo storage. Docker uses /app/data/uploads on the persistent volume.
UPLOAD_DIR=./data/uploads
