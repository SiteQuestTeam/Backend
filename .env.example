# Klucz API OpenAI. Nigdy nie wysyłaj prawdziwego klucza do gita.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=8000

# KCK / geocoding
KCK_TIMEOUT_MS=15000
MSIP_TIMEOUT_MS=5000

# Trwałe dane SideQuest. W Dockerze zamontuj wolumen pod /app/data.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads

# Punkty za skuteczne zgłoszenie KCK; tylko po otrzymaniu incidentId.
KCK_POINTS_REWARD=10
